{
  "name": "fullstack-practice",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "shared": "npm run dev --prefix shared",
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "build": "npm --prefix client run build",
    "test": "cross-env NODE_ENV=test vitest",
    "test:run": "cross-env NODE_ENV=test vitest run",
    "lint": "oxlint",
    "format": "prettier . --write",
    "check-format": "prettier . --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loic-Rodrigue-Gauthier/fullstack-practice.git"
  },
  "bugs": {
    "url": "https://github.com/Loic-Rodrigue-Gauthier/fullstack-practice/issues"
  },
  "homepage": "https://github.com/Loic-Rodrigue-Gauthier/fullstack-practice#readme",
  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
